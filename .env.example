# Public URL of the site (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com

# Form delivery via Resend (https://resend.com). Without these, forms only
# log to the server console in development and fail in production.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. "Apostle Daniel Ogidi <no-reply@yourdomain.com>"
MAIL_FROM=
# Where invitations and messages are delivered. Comma-separate for several inboxes.
MAIL_TO=
